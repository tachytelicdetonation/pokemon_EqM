{
  "model": "EqM-B/2",
  "device": "cuda",
  "image_size": 256,
  "batch_size": 16,
  "epochs": 80,
  "log_every": 100,
  "ckpt_every": 1000,
  "sample_every": 1000,
  "sample_batch_size": 8,
  "num_workers": 4,
  "wandb": true,
  "data_path": "data/train",
  "results_dir": "results",
  "vae": "ema",
  "vae_channels": 4,
  "num_classes": 4,
  "global_seed": 0,
  "cfg_scale": 4.0,
  "uncond": true,
  "ebm": "none",
  "use_disp": true,
  "grad_clip": 0.0,
  "use_liere": true,
  "liere_jitter_std": 0.1,
  "liere_jitter_mode": "dinov3",
  "liere_pos_embed_shift": 0.1,
  "liere_pos_embed_jitter": 1.5,
  "liere_pos_embed_rescale": 2.0,
  "path_type": "Linear",
  "prediction": "velocity",
  "loss_weight": null,
  "sample_eps": 0.0,
  "train_eps": 0.0,
  "calculate_fid": true,
  "fid_every": 2000,
  "num_fid_samples": 2000,
  "warmup_steps": 1000,
  "mixed_precision": "bf16",
  "num_registers": 4,
  "use_sigreg": true,
  "sigreg_lambda": 0.05,
  "sigreg_num_slices": 1024,
  "use_diff_attn": true,
  "use_spatial_decay": true,
  "spatial_decay_rate": 0.1,
  "spatial_decay_radius": 0.25,
  "use_per_head_decay": true,
  "decay_type": "learned",
  "distance_type": "l2",
  "use_content_gate": false,
  "use_matrix_lambda": true,
  "matrix_lambda_scale": 1.0,
  "matrix_lambda_use_qk": true,
  "compute_attention_metrics": true,
  "attention_viz_every": 10,
  "attention_sparsity_threshold": 0.01,
  "attention_top_k": 5,

  "use_aux_losses": true,
  "aux_entropy_floor_threshold": 0.3,
  "aux_entropy_floor_weight": 0.02,
  "aux_entropy_ceiling_threshold": 0.85,
  "aux_entropy_ceiling_weight": 0.02,
  "aux_gate_entropy_weight": 0.01,
  "aux_gate_sparsity_weight": 0.005,
  "aux_hsic_weight": 0.01,
  "aux_position_disagreement_weight": 0.005,
  "aux_lambda_smoothness_weight": 0.001,
  "aux_lambda_entropy_weight": 0.01,
  "aux_hard_focus_weight": 0.02,
  "aux_complexity_diversity_weight": 0.01,
  "aux_complexity_ortho_weight": 0.01,
  "aux_load_balance_weight": 0.005,
  "aux_warmup_steps": 1000,

  "use_complexity_bias": true,
  "complexity_method": "variance",
  "complexity_bias_scale": 1.0,

  "use_head_routing": true,

  "use_lejepa": true,
  "lejepa_sigreg_weight": 0.05,
  "lejepa_invariance_weight": 0.02,
  "lejepa_prediction_weight": 0.1,
  "lejepa_use_invariance": true,
  "lejepa_use_prediction": true,
  "lejepa_predictor_dim": 384,
  "lejepa_mask_ratio": 0.6
}
