{
  "model": "EqM-B/2",
  "device": "cuda",
  "image_size": 256,
  "batch_size": 32,
  "epochs": 80,
  "log_every": 100,
  "ckpt_every": 1000,
  "sample_every": 1000,
  "sample_batch_size": 8,
  "num_workers": 4,
  "wandb": true,
  "data_path": "data/train",
  "results_dir": "results",
  "vae": "ema",
  "vae_channels": 4,
  "num_classes": 4,
  "global_seed": 0,
  "cfg_scale": 4.0,
  "uncond": true,
  "ebm": "none",
  "use_disp": true,
  "grad_clip": 0.0,
  "use_liere": true,
  "liere_jitter_std": 0.1,
  "liere_jitter_mode": "dinov3",
  "liere_pos_embed_shift": 0.1,
  "liere_pos_embed_jitter": 1.5,
  "liere_pos_embed_rescale": 2.0,
  "path_type": "Linear",
  "prediction": "velocity",
  "loss_weight": null,
  "sample_eps": 0.0,
  "train_eps": 0.0,
  "calculate_fid": true,
  "fid_every": 2000,
  "num_fid_samples": 2000,
  "warmup_steps": 1000,
  "mixed_precision": "bf16",
  "num_registers": 4,
  "use_sigreg": true,
  "sigreg_lambda": 0.05,
  "sigreg_num_slices": 1024,
  "use_diff_attn": true,
  "use_spatial_decay": true,
  "spatial_decay_rate": 0.1,
  "spatial_decay_radius": 0.25,
  "use_per_head_decay": true,
  "decay_type": "learned",
  "distance_type": "l2",
  "use_content_gate": false,
  "compute_attention_metrics": true,
  "attention_viz_every": 50,
  "attention_sparsity_threshold": 0.01,
  "attention_top_k": 5
}