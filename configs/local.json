{
    "model": "EqM-S/2",
    "device": "mps",
    "image_size": 64,
    "batch_size": 4,
    "epochs": 1,
    "log_every": 10,
    "ckpt_every": 100,
    "sample_every": 100,
    "sample_batch_size": 4,
    "num_workers": 0,
    "wandb": false,
    "data_path": "data/train",
    "results_dir": "results_local",
    "vae": "ema",
    "vae_channels": 4,
    "num_classes": 4,
    "global_seed": 0,
    "cfg_scale": 4.0,
    "uncond": true,
    "ebm": "none",
    "use_disp": true,
    "grad_clip": 1.0,
    "use_liere": true,
    "liere_jitter_std": 0.0,
    "liere_jitter_mode": "gaussian",
    "liere_pos_embed_shift": null,
    "liere_pos_embed_jitter": null,
    "liere_pos_embed_rescale": 2.0,
    "path_type": "Linear",
    "prediction": "velocity",
    "loss_weight": "velocity",
    "sample_eps": 0.0,
    "train_eps": 0.0,
    "num_registers": 4,
    "use_sigreg": true,
    "sigreg_lambda": 0.05,
    "sigreg_num_slices": 256,
    "use_diff_attn": true,
    "use_spatial_decay": true,
    "spatial_decay_rate": 0.1,
    "spatial_decay_radius": 0.25,
    "use_per_head_decay": true,
    "decay_type": "learned",
    "distance_type": "l2",
    "use_content_gate": false,
    "log_attention_every": 100,
    "compute_attention_metrics": true,
    "attention_sparsity_threshold": 0.01,
    "attention_top_k": 5
}